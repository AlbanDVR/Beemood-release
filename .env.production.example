# Database Configuration
POSTGRES_USER=beemood
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=beemooddb

# Backend Application
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://your-domain.com/login
JWT_SECRET_KEY=generate_a_strong_random_secret_key_here

# GitLab Registry (for production deployment)
CI_REGISTRY_IMAGE=registry.gitlab.com/your-group/release
